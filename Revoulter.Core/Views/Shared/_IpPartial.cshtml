@using Microsoft.AspNetCore.Identity
@using Revoulter.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="d-flex align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {

        <li class="nav-item"><a class="nav-link" asp-controller="IpUpload" asp-action="Index">Register IP</a></li>
        <li class="nav-item"> <a class="nav-link" asp-controller="IpUpload" asp-action="MyAssets">Your IP</a></li>
 
    }

</div>

<style>
    /* Active link hover effect */
    .btn-outline-dark:hover {
        background-color: #f5f5f5;
        color: #000;
        transition: 0.2s;
    }

    .btn-dark:hover {
        background-color: #222;
        transition: 0.2s;
    }

    /* Mobile responsive tweaks */
    @@media (max-width: 992px) {
        .d-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>
