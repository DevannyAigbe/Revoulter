@using Microsoft.AspNetCore.Identity
@using Revoulter.Core.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
<div class="d-flex align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        <span class="me-3">Hello @User.Identity?.Name!</span>
        <a style="color: #f5f5f5;" class="nav-link" asp-area="Identity" asp-page="/Account/Manage/Index">
            Manage Account
        </a>
        <form class="nav_form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" id="logoutBtn" class="logout">Logout</button>
        </form>
    }
    else
    {
        <a style="color: #f5f5f5;" class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            Register
        </a>
        <a style="color: #f5f5f5;" class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            Sign In
        </a>
    }
</div>
<style>
    a{
        color: #f5f5f5;
    }

    /* Active link hover effect */
    .btn-outline-dark:hover {
        background-color: #f5f5f5;
        color: #000;
        transition: 0.2s;
    }

    .btn-dark:hover {
        background-color: #222;
        transition: 0.2s;
    }
    /* Mobile responsive tweaks */
    @@media (max-width: 992px) {
        .d-flex {
            flex-direction: column;
            gap: 0.5rem;
        }
    }
</style>