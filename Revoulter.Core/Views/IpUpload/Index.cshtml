@model Revoulter.Core.Models.IpAsset
@{
    ViewData["Title"] = "Upload IP Asset";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container my-5">
    <div class="card border-2 shadow-sm">
        <div class="card-header">
            <h2 class="mb-1">Register Your IP Asset</h2>
            <p class="text-muted mb-0">Protect your creative work and track ownership.</p>

            <!-- Step indicators -->
            <div class="d-flex justify-content-between mt-3 mb-1">
                <div class="step" id="step1-indicator">1</div>
                <div class="flex-fill mx-1 align-self-center">
                    <hr class="step-line" />
                </div>
                <div class="step" id="step2-indicator">2</div>
                <div class="flex-fill mx-1 align-self-center">
                    <hr class="step-line" />
                </div>
                <div class="step" id="step3-indicator">3</div>
            </div>
            <div class="d-flex justify-content-between text-muted small mb-2">
                <span>Asset Details</span>
                <span>Category</span>
                <span>Ownership</span>
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                <!-- Step 1 -->
                <div class="step-content" id="step1">
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label">Asset Title *</label>
                        <input asp-for="Title" class="form-control" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description *</label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label for="file" class="form-label">Upload Asset File (Optional)</label>
                        <div class="border border-dashed p-4 text-center rounded" id="fileDropArea">
                            <p class="mb-1">Drag and drop a file or click to select</p>
                            <p class="text-muted small">PNG, JPG, MP3, MP4 up to 5MB</p>
                            <input type="file" name="file" class="form-control d-none" id="fileInput" />
                            <p id="fileName" class="mt-2 text-success"></p>
                        </div>
                    </div>

                    <button type="button" class="btn btn-primary w-100" onclick="nextStep()">Next: Category</button>
                </div>

                <!-- Step 2 -->
                <div class="step-content d-none" id="step2">
                    <div class="mb-3">
                        <label asp-for="Category" class="form-label">Category *</label>
                        <select asp-for="Category" class="form-select" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="Category" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">YouTube Link (Optional)</label>
                        <input type="url" name="YoutubeLink" class="form-control" placeholder="Enter YouTube link" />
                        <small class="text-muted">Add a YouTube link to display track statistics</small>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary flex-fill" onclick="prevStep()">Back</button>
                        <button type="button" class="btn btn-primary flex-fill" onclick="nextStep()">Next: Ownership</button>
                    </div>
                </div>

                <!-- Step 3 -->
                <div class="step-content d-none" id="step3">
                    <div class="mb-3 form-check form-switch d-flex align-items-center justify-content-between">
                        <label class="form-check-label">Multiple Co-Owners</label>
                        <input type="checkbox" class="form-check-input" id="coOwnersToggle" onchange="toggleCoOwners()" />
                    </div>

                    <div id="singleOwnerDiv">
                        <label asp-for="OwnershipPercentage" class="form-label">Ownership Percentage *</label>
                        <input asp-for="OwnershipPercentage" class="form-control" type="number" min="1" max="100" step="0.01" />
                        <span asp-validation-for="OwnershipPercentage" class="text-danger"></span>
                    </div>

                    <div id="coOwnersDiv" class="d-none">
                        <div id="coOwnersList"></div>
                        <button type="button" class="btn btn-outline-primary mt-2" onclick="addCoOwner()">Add Co-Owner</button>
                        <div class="mt-2 text-danger" id="ownershipError"></div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="button" class="btn btn-outline-secondary flex-fill" onclick="prevStep()">Back</button>
                        <button type="submit" class="btn btn-success flex-fill">Register Asset</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let currentStep = 1;
    const totalSteps = 3;

    function showStep(step) {
        for (let i = 1; i <= totalSteps; i++) {
            document.getElementById('step' + i).classList.add('d-none');
            document.getElementById('step' + i + '-indicator').classList.remove('bg-primary', 'text-white');
        }
        document.getElementById('step' + step).classList.remove('d-none');
        document.getElementById('step' + step + '-indicator').classList.add('bg-primary', 'text-white');
        currentStep = step;
    }

    function nextStep() {
        if (currentStep < totalSteps) showStep(currentStep + 1);
    }
    function prevStep() {
        if (currentStep > 1) showStep(currentStep - 1);
    }

    // File drag & drop
    const fileDropArea = document.getElementById('fileDropArea');
    const fileInput = document.getElementById('fileInput');
    const fileName = document.getElementById('fileName');

    fileDropArea.addEventListener('click', () => fileInput.click());
    fileInput.addEventListener('change', (e) => {
        if (e.target.files.length > 0) {
            fileName.textContent = e.target.files[0].name;
        }
    });

    // Co-owners
    const coOwnersDiv = document.getElementById('coOwnersDiv');
    const singleOwnerDiv = document.getElementById('singleOwnerDiv');
    const coOwnersToggle = document.getElementById('coOwnersToggle');
    const coOwnersList = document.getElementById('coOwnersList');

    function toggleCoOwners() {
        if (coOwnersToggle.checked) {
            coOwnersDiv.classList.remove('d-none');
            singleOwnerDiv.classList.add('d-none');
            coOwnersList.innerHTML = '';
            addCoOwner();
            addCoOwner();
        } else {
            coOwnersDiv.classList.add('d-none');
            singleOwnerDiv.classList.remove('d-none');
        }
    }

    function addCoOwner() {
        const index = coOwnersList.children.length + 1;
        const div = document.createElement('div');
        div.className = 'd-flex gap-2 mb-2';
        div.innerHTML = `
            <input type="text" name="CoOwners[${index - 1}].Name" class="form-control" placeholder="Co-Owner ${index} Name" required />
            <input type="number" name="CoOwners[${index - 1}].Percentage" class="form-control" placeholder="%" min="0" max="100" required />
            <button type="button" class="btn btn-outline-danger" onclick="removeCoOwner(this)">Remove</button>
        `;
        coOwnersList.appendChild(div);
    }

    function removeCoOwner(btn) {
        coOwnersList.removeChild(btn.parentElement);
    }

    // Initialize first step
    showStep(1);
</script>

<style>
    .border-dashed {
        border-style: dashed !important;
    }

    .step {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        border: 1px solid #ccc;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .step-line {
        border-top: 2px solid #ccc;
        margin: 0;
    }
</style>
